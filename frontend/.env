# OpenWeatherMap API Key - Get free key at https://openweathermap.org/api
# For now using demo - you need to register and add your key here
VITE_OPENWEATHER_API_KEY=demo

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Map Configuration
VITE_DEFAULT_LAT=13.0827
VITE_DEFAULT_LNG=80.2707
VITE_DEFAULT_ZOOM=6
